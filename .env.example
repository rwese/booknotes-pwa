VITE_PROXY_URL=https://booknotes-proxy.your-subdomain.workers.dev
VITE_PROXY_API_KEY=your-api-key-here

# S3 Configuration for publish.sh
S3_BUCKET=your-bucket-name
S3_ENDPOINT=https://s3.example.com  # Leave empty for AWS
S3_REGION=us-east-1
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_ACL=public-read
